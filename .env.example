# Optional environment variables. Set in the terminal; .env is not loaded automatically.
# The review service is fixed to loopback port 8000 by scripts/start.ps1.
TENDER_CASE_ROOT=./outputs
# Ollama defaults to 11434. The portable GGUF backend defaults to loopback port 8081.
TENDER_LOCAL_MODEL_URL=http://127.0.0.1:11434
# Optional override: ollama or llamacpp. Otherwise inferred from the selected tag/filename.
TENDER_LOCAL_MODEL_BACKEND=ollama
